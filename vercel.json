{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm vite build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/((?!manus-storage/|assets/|images/).*)", "destination": "/index.html" }
  ]
}
